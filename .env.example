# --- Core ---
JARVIS_API_KEY=change-me-long-random-string   # required for /api/* management routes
JARVIS_DB=/data/jarvis.db                       # SQLite file; put it on a persistent disk
PUBLIC_BASE_URL=https://your-app.example.com    # used for Twilio signature checks + /api/sip

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- SIP / voice (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=          # when set, every /voice request must carry a valid Twilio signature
TWILIO_FROM_NUMBER=+27...   # your Twilio number: caller ID for transfers and SMS
SIP_DOMAIN=jarvis-yourco.sip.twilio.com
TWILIO_VOICE=Polly.Ayanda-Neural
VOICE_LANGUAGE=en-ZA
ALLOW_UNKNOWN_CALLERS=0     # 1 = let unregistered numbers in with crew (read-only) rights

# --- Email (your PA inbox) ---
MAIL_BACKEND=graph            # Outlook / Microsoft 365 (default when MS_* are set). imap = Gmail or other hosts
# Microsoft 365 / Outlook (Azure app registration, application permissions Mail.Read + Mail.Send)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=you@yourcivils.co.za
# IMAP/SMTP (Gmail: turn on 2-step verification, then create an App Password)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_USER=you@gmail.com
MAIL_PASSWORD=app-password-here
MAIL_FROM=Your Name <you@gmail.com>

# --- Outlook calendar (same Microsoft app; add Calendars.ReadWrite) ---
OUTLOOK_CALENDAR=1                        # 0 turns calendar sync off
OUTLOOK_TIMEZONE=South Africa Standard Time
CALENDAR_TZ=Africa/Johannesburg
CALENDAR_INVITE_STAFF=0                   # 1 = also send each crew member an Outlook invite for their jobs (needs staff email)

# --- Keep me updated ---
JARVIS_SCHEDULER=1                 # built-in scheduler (needs the server always on); or use a cron hitting /api/updates/run
NOTIFY_CHANNELS=whatsapp,email     # any of: whatsapp, sms, email
OWNER_PHONE=+2782xxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
MORNING_BRIEF_AT=06:00
EVENING_WRAP_AT=17:30
CHECK_EVERY_MIN=15
WORK_HOURS=06:00-19:00
