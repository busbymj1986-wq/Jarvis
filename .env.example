# --- Core ---
JARVIS_API_KEY=change-me-long-random-string   # required for /api/* management routes
JARVIS_DB=/data/jarvis.db                       # SQLite file; put it on a persistent disk
JARVIS_PROVIDER=claude                          # default agent: claude | grok
PUBLIC_BASE_URL=https://your-app.example.com    # used for Twilio signature checks + /api/sip

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- Grok (xAI) ---
XAI_API_KEY=
XAI_MODEL=grok-4

# --- SIP / voice (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=          # when set, every /voice request must carry a valid Twilio signature
TWILIO_FROM_NUMBER=+27...   # your Twilio number: caller ID for transfers and SMS
SIP_DOMAIN=jarvis-yourco.sip.twilio.com
VOICE_PROVIDER=claude       # which agent answers the phone
TWILIO_VOICE=Polly.Ayanda-Neural
VOICE_LANGUAGE=en-ZA
ALLOW_UNKNOWN_CALLERS=0     # 1 = let unregistered numbers in with crew (read-only) rights
